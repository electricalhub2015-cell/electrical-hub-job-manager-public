
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#102b46">
<title>ELECTRICAL HUB INC. | Job Manager</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  --navy:#102b46;
  --navy2:#1c4564;
  --green:#b9efc7;
  --green-dark:#267747;
  --bg:#f3f7f5;
  --white:#fff;
  --border:#dce6e0;
  --muted:#65766f;
}
* { box-sizing:border-box; }
body {
  margin:0; background:var(--bg); color:var(--navy);
  font-family:Arial,Helvetica,sans-serif;
}
header {
  background:var(--navy); color:white; padding:20px 16px;
  border-bottom:5px solid var(--green);
}
.header-inner, main { max-width:1050px; margin:auto; }
.brand { font-size:22px; font-weight:800; letter-spacing:.5px; }
.subtitle { margin-top:5px; color:#d9e8e0; font-size:13px; }
main { padding:16px; }
.card {
  background:white; border:1px solid var(--border);
  border-radius:14px; padding:16px; margin-bottom:14px;
  box-shadow:0 3px 12px #102b4608;
}
h2 { margin:0 0 12px; font-size:19px; }
h3 { margin:0 0 8px; font-size:16px; }
label { display:block; font-size:13px; font-weight:700; margin-bottom:6px; }
input,textarea,select {
  width:100%; padding:12px; border:1px solid #cbd9d1;
  border-radius:9px; font-size:16px; background:white; color:var(--navy);
  margin-bottom:12px; min-width:0;
}
textarea { min-height:76px; resize:vertical; }
button {
  border:0; border-radius:9px; padding:11px 14px;
  font-size:14px; font-weight:700; cursor:pointer;
}
.primary { background:var(--green); color:var(--navy); }
.dark { background:var(--navy); color:white; }
.outline { background:white; color:var(--navy); border:1px solid var(--border); }
.danger { background:#fff0ef; color:#a12d28; }
button:disabled { opacity:.5; cursor:wait; }
.grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.field { min-width:0; }
.actions { display:flex; flex-wrap:wrap; gap:8px; }
.tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-bottom:14px; }
.tab { background:#e5eee8; color:var(--navy); padding:13px 5px; }
.tab.active { background:var(--navy); color:white; }
.stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:9px; }
.stat { background:#f0f8f2; border-radius:10px; padding:12px; }
.stat-label { font-size:12px; color:var(--muted); }
.stat-value { font-weight:800; font-size:18px; margin-top:5px; overflow-wrap:anywhere; }
.job { border:1px solid var(--border); border-radius:12px; padding:14px; margin-top:10px; }
.job-top { display:flex; justify-content:space-between; gap:10px; align-items:flex-start; }
.job-name { font-weight:800; font-size:17px; overflow-wrap:anywhere; }
.muted { color:var(--muted); font-size:13px; line-height:1.5; }
.pill { display:inline-block; padding:5px 8px; border-radius:20px; font-size:11px; font-weight:700; background:#e8f5eb; margin:3px 3px 3px 0; }
.hidden { display:none!important; }
.notice { font-size:13px; padding:10px; border-radius:8px; margin-bottom:12px; }
.info { background:#eaf3ff; color:#244c75; }
.error { background:#fff0ef; color:#9b2828; }
.success { background:#e8f7eb; color:#20663b; }
hr { border:0; border-top:1px solid var(--border); margin:14px 0; }
@media(max-width:560px) {
  .grid { grid-template-columns:1fr; gap:0; }
  .stats { grid-template-columns:1fr 1fr; }
  .brand { font-size:20px; }
  main { padding:10px; }
  .card { padding:13px; }
}
</style>
</head>
<body>
<header>
  <div class="header-inner">
    <div class="brand">ELECTRICAL HUB INC.</div>
    <div class="subtitle">JOB MANAGEMENT • SIMPLE • ORGANIZED</div>
  </div>
</header>

<main>
  <div id="message" class="notice hidden"></div>

  <section id="loginCard" class="card">
    <h2>Welcome</h2>
    <p class="muted">Sign in to access your jobs from your phone.</p>
    <label for="email">Email</label>
    <input id="email" type="email" autocomplete="email"
      placeholder="you@example.com">
    <label for="password">Password</label>
    <input id="password" type="password" autocomplete="current-password"
      placeholder="Your password">
    <div class="actions">
      <button class="primary" id="loginBtn" onclick="signIn()">Sign In</button>
      <button class="outline" id="signupBtn" onclick="signUp()">Create Account</button>
    </div>
    <p class="muted">Use your existing account if you already registered.</p>
  </section>

  <section id="app" class="hidden">
    <div class="card">
      <div class="job-top">
        <div>
          <h2>Job Dashboard</h2>
          <div id="userEmail" class="muted"></div>
        </div>
        <button class="outline" onclick="signOut()">Sign Out</button>
      </div>
      <hr>
      <div class="stats">
        <div class="stat">
          <div class="stat-label">Accepted Jobs</div>
          <div class="stat-value" id="acceptedCount">0</div>
        </div>
        <div class="stat">
          <div class="stat-label">Follow-Up</div>
          <div class="stat-value" id="followCount">0</div>
        </div>
        <div class="stat">
          <div class="stat-label">Completed</div>
          <div class="stat-value" id="completedCount">0</div>
        </div>
      </div>
    </div>

    <div class="actions" style="margin-bottom:12px">
      <button class="primary" onclick="newJob()">＋ Add New Job</button>
      <button class="outline" onclick="exportJobs()">Export Backup</button>
      <button class="outline" onclick="document.getElementById('importFile').click()">Import Backup</button>
      <input id="importFile" type="file" accept=".json,application/json"
        class="hidden" onchange="importJobs(event)">
    </div>

    <section id="editor" class="card hidden">
      <h2 id="editorTitle">Add Job</h2>
      <form id="jobForm" onsubmit="saveJob(event)">
        <input type="hidden" id="jobId">
        <div class="grid">
          <div class="field">
            <label for="client">Customer / Company *</label>
            <input id="client" required placeholder="Customer name">
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" type="tel" placeholder="Phone number">
          </div>
          <div class="field">
            <label for="address">Job Site Address *</label>
            <input id="address" required placeholder="Job address">
          </div>
          <div class="field">
            <label for="jobDate">Job Date</label>
            <input id="jobDate" type="date">
          </div>
          <div class="field">
            <label for="status">Job Status</label>
            <select id="status">
              <option value="Accepted">Accepted</option>
              <option value="Follow-Up">Follow-Up</option>
              <option value="Completed">Completed</option>
            </select>
          </div>
          <div class="field">
            <label for="followUpDate">Follow-Up Date</label>
            <input id="followUpDate" type="date">
          </div>
          <div class="field">
            <label for="invoiceTotal">Total Invoice (including tax) $</label>
            <input id="invoiceTotal" type="number" min="0" step="0.01" value="0">
          </div>
          <div class="field">
            <label for="costs">Total Costs (including tax) $</label>
            <input id="costs" type="number" min="0" step="0.01" value="0">
          </div>
          <div class="field">
            <label for="paymentStatus">Payment Status</label>
            <select id="paymentStatus">
              <option>Not Invoiced</option>
              <option>Invoiced</option>
              <option>Partially Paid</option>
              <option>Paid</option>
              <option>Overdue</option>
            </select>
          </div>
          <div class="field">
            <label for="esaStatus">ESA Status</label>
            <select id="esaStatus">
              <option>Not Required</option>
              <option>Not Submitted</option>
              <option>Submitted</option>
              <option>Inspection Booked</option>
              <option>Passed</option>
              <option>Deficiency</option>
            </select>
          </div>
        </div>
        <label for="description">Job Description</label>
        <textarea id="description" placeholder="Work to be completed or performed"></textarea>
        <label for="notes">Notes</label>
        <textarea id="notes" placeholder="Materials, reminders, other details"></textarea>

        <div class="stat" style="margin-bottom:14px">
          <div class="stat-label">Estimated Profit (before tax)</div>
          <div class="stat-value" id="profitPreview">$0.00</div>
          <div class="muted">Calculated as (invoice total − costs) ÷ 1.13</div>
        </div>
        <div class="actions">
          <button class="primary" id="saveBtn" type="submit">Save Job</button>
          <button class="outline" type="button" onclick="closeEditor()">Cancel</button>
        </div>
      </form>
    </section>

    <div class="card">
      <label for="search">Search Jobs</label>
      <input id="search" placeholder="Search customer, address, or phone"
        oninput="renderJobs()">
      <div class="tabs">
        <button class="tab active" data-tab="Accepted" onclick="setTab('Accepted')">Accepted</button>
        <button class="tab" data-tab="Follow-Up" onclick="setTab('Follow-Up')">Follow-Up</button>
        <button class="tab" data-tab="Completed" onclick="setTab('Completed')">Completed</button>
      </div>
      <div id="jobList"></div>
    </div>
  </section>
</main>

<script>
const SUPABASE_URL = "https://rczdillhudoigtrzgylx.supabase.co";
const SUPABASE_KEY = "sb_publishable_GLuyDwt53r_jczKaNuuFpg_hi1nSsKa";

const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
let currentUser = null;
let jobs = [];
let activeTab = "Accepted";

function money(value) {
  return new Intl.NumberFormat("en-CA", {
    style:"currency", currency:"CAD"
  }).format(Number(value) || 0);
}
function profit(job) {
  return ((Number(job.invoiceTotal)||0) - (Number(job.costs)||0)) / 1.13;
}
function showMessage(text, type="info") {
  const el = document.getElementById("message");
  el.textContent = text;
  el.className = "notice " + type;
}
function clearMessage() {
  document.getElementById("message").className = "notice hidden";
}
function setBusy(busy) {
  document.getElementById("loginBtn").disabled = busy;
  document.getElementById("signupBtn").disabled = busy;
}
async function signIn() {
  clearMessage();
  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;
  if (!email || !password) return showMessage("Enter your email and password.", "error");
  setBusy(true);
  const {error} = await db.auth.signInWithPassword({email,password});
  setBusy(false);
  if (error) showMessage(error.message, "error");
}
async function signUp() {
  clearMessage();
  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;
  if (!email || !password) return showMessage("Enter your email and password.", "error");
  if (password.length < 6) return showMessage("Use a password with at least 6 characters.", "error");
  setBusy(true);
  const {error} = await db.auth.signUp({email,password});
  setBusy(false);
  if (error) showMessage(error.message, "error");
  else showMessage("Account created. If email confirmation is enabled, check your inbox before signing in.", "success");
}
async function signOut() {
  await db.auth.signOut();
}
db.auth.onAuthStateChange((_event, session) => {
  currentUser = session?.user || null;
  updateScreen();
});
async function updateScreen() {
  const loggedIn = !!currentUser;
  document.getElementById("loginCard").classList.toggle("hidden", loggedIn);
  document.getElementById("app").classList.toggle("hidden", !loggedIn);
  if (loggedIn) {
    document.getElementById("userEmail").textContent = currentUser.email || "";
    await loadJobs();
  } else {
    jobs = [];
    closeEditor();
  }
}
async function loadJobs() {
  if (!currentUser) return;
  showMessage("Loading your jobs…", "info");
  const {data,error} = await db.from("jobs")
    .select("id,job_data,created_at,updated_at")
    .eq("user_id",currentUser.id)
    .order("created_at",{ascending:false});
  if (error) {
    showMessage("Could not load jobs: " + error.message +
      ". Check that the Supabase jobs table and policies are configured.", "error");
    return;
  }
  jobs = (data || []).map(row => ({...row.job_data, id:row.id}));
  clearMessage();
  renderJobs();
}
function setTab(tab) {
  activeTab = tab;
  document.querySelectorAll(".tab").forEach(b =>
    b.classList.toggle("active",b.dataset.tab===tab));
  renderJobs();
}
function updateStats() {
  document.getElementById("acceptedCount").textContent =
    jobs.filter(j => j.status==="Accepted").length;
  document.getElementById("followCount").textContent =
    jobs.filter(j => j.status==="Follow-Up").length;
  document.getElementById("completedCount").textContent =
    jobs.filter(j => j.status==="Completed").length;
}
function safe(value) {
  return String(value ?? "").replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));
}
function renderJobs() {
  updateStats();
  const query = document.getElementById("search").value.trim().toLowerCase();
  const filtered = jobs.filter(j => (j.status || "Accepted") === activeTab &&
    [j.client,j.address,j.phone,j.description,j.notes]
      .some(v => String(v||"").toLowerCase().includes(query)));
  const list = document.getElementById("jobList");
  if (!filtered.length) {
    list.innerHTML = '<p class="muted">No jobs here yet. Tap “Add New Job” to get started.</p>';
    return;
  }
  list.innerHTML = filtered.map(j => `
    <article class="job">
      <div class="job-top">
        <div>
          <div class="job-name">${safe(j.client || "Unnamed job")}</div>
          <div class="muted">${safe(j.address || "")}</div>
          ${j.phone ? `<div class="muted">${safe(j.phone)}</div>` : ""}
        </div>
        <span class="pill">${safe(j.status || "Accepted")}</span>
      </div>
      ${j.jobDate ? `<p class="muted">Job date: ${safe(j.jobDate)}</p>` : ""}
      ${j.followUpDate ? `<p class="muted">Follow-up: ${safe(j.followUpDate)}</p>` : ""}
      ${j.description ? `<p>${safe(j.description)}</p>` : ""}
      <div class="stat" style="margin:10px 0">
        <div class="grid">
          <div><div class="stat-label">Invoice total</div><strong>${money(j.invoiceTotal)}</strong></div>
          <div><div class="stat-label">Total costs</div><strong>${money(j.costs)}</strong></div>
          <div><div class="stat-label">Estimated profit</div><strong>${money(profit(j))}</strong></div>
          <div><div class="stat-label">Payment</div><strong>${safe(j.paymentStatus || "Not Invoiced")}</strong></div>
          <div><div class="stat-label">ESA</div><strong>${safe(j.esaStatus || "Not Required")}</strong></div>
        </div>
      </div>
      ${j.notes ? `<p class="muted">Notes: ${safe(j.notes)}</p>` : ""}
      <div class="actions">
        ${j.phone ? `<button class="outline" onclick="callPhone('${encodeURIComponent(j.phone)}')">Call</button>` : ""}
        <button class="outline" onclick="editJob('${safe(j.id)}')">Edit</button>
        ${j.status!=="Completed" ?
          `<button class="primary" onclick="changeStatus('${safe(j.id)}','Completed')">Mark Completed</button>` :
          `<button class="outline" onclick="changeStatus('${safe(j.id)}','Accepted')">Reopen Job</button>`}
        ${j.status==="Accepted" ?
          `<button class="outline" onclick="changeStatus('${safe(j.id)}','Follow-Up')">Move to Follow-Up</button>` : ""}
        ${j.status==="Follow-Up" ?
          `<button class="outline" onclick="changeStatus('${safe(j.id)}','Accepted')">Move to Accepted</button>` : ""}
        <button class="danger" onclick="deleteJob('${safe(j.id)}')">Delete</button>
      </div>
    </article>`).join("");
}
function callPhone(phone) {
  location.href = "tel:" + decodeURIComponent(phone);
}
function newJob() {
  document.getElementById("jobForm").reset();
  document.getElementById("jobId").value = "";
  document.getElementById("invoiceTotal").value = "0";
  document.getElementById("costs").value = "0";
  document.getElementById("status").value = activeTab;
  document.getElementById("editorTitle").textContent = "Add Job";
  document.getElementById("editor").classList.remove("hidden");
  document.getElementById("editor").scrollIntoView({behavior:"smooth"});
  updateProfit();
}
function closeEditor() {
  document.getElementById("editor")?.classList.add("hidden");
}
function editJob(id) {
  const j = jobs.find(x => x.id === id);
  if (!j) return;
  document.getElementById("jobId").value = j.id;
  ["client","phone","address","jobDate","status","followUpDate",
   "invoiceTotal","costs","paymentStatus","esaStatus","description","notes"]
    .forEach(key => document.getElementById(key).value = j[key] ?? "");
  document.getElementById("editorTitle").textContent = "Edit Job";
  document.getElementById("editor").classList.remove("hidden");
  document.getElementById("editor").scrollIntoView({behavior:"smooth"});
  updateProfit();
}
async function saveJob(event) {
  event.preventDefault();
  if (!currentUser) return showMessage("Please sign in again.", "error");
  const id = document.getElementById("jobId").value || crypto.randomUUID();
  const job = {
    id,
    client:document.getElementById("client").value.trim(),
    phone:document.getElementById("phone").value.trim(),
    address:document.getElementById("address").value.trim(),
    jobDate:document.getElementById("jobDate").value,
    status:document.getElementById("status").value,
    followUpDate:document.getElementById("followUpDate").value,
    invoiceTotal:Number(document.getElementById("invoiceTotal").value)||0,
    costs:Number(document.getElementById("costs").value)||0,
    paymentStatus:document.getElementById("paymentStatus").value,
    esaStatus:document.getElementById("esaStatus").value,
    description:document.getElementById("description").value.trim(),
    notes:document.getElementById("notes").value.trim()
  };
  const btn = document.getElementById("saveBtn");
  btn.disabled = true;
  btn.textContent = "Saving…";
  const {error} = await db.from("jobs").upsert({
    id:job.id,
    user_id:currentUser.id,
    job_data:job,
    updated_at:new Date().toISOString()
  });
  btn.disabled = false;
  btn.textContent = "Save Job";
  if (error) return showMessage("Could not save job: " + error.message, "error");
  const index = jobs.findIndex(j => j.id === id);
  if (index >= 0) jobs[index] = job;
  else jobs.unshift(job);
  closeEditor();
  setTab(job.status);
  showMessage("Job saved successfully.", "success");
}
async function changeStatus(id,status) {
  const j = jobs.find(x => x.id === id);
  if (!j || !currentUser) return;
  const updated = {...j,status};
  const {error} = await db.from("jobs").update({
    job_data:updated,updated_at:new Date().toISOString()
  }).eq("id",id).eq("user_id",currentUser.id);
  if (error) return showMessage("Could not update job: " + error.message, "error");
  jobs = jobs.map(x => x.id===id ? updated : x);
  setTab(status);
  showMessage("Job moved to " + status + ".", "success");
}
async function deleteJob(id) {
  if (!confirm("Delete this job permanently? Export a backup first if needed.")) return;
  const {error} = await db.from("jobs").delete()
    .eq("id",id).eq("user_id",currentUser.id);
  if (error) return showMessage("Could not delete job: " + error.message, "error");
  jobs = jobs.filter(j => j.id!==id);
  renderJobs();
  showMessage("Job deleted.", "success");
}
function updateProfit() {
  const invoice = Number(document.getElementById("invoiceTotal").value)||0;
  const costs = Number(document.getElementById("costs").value)||0;
  document.getElementById("profitPreview").textContent = money((invoice-costs)/1.13);
}
document.getElementById("invoiceTotal").addEventListener("input",updateProfit);
document.getElementById("costs").addEventListener("input",updateProfit);

function exportJobs() {
  const blob = new Blob([JSON.stringify(jobs,null,2)],{type:"application/json"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "electrical-hub-jobs-backup.json";
  a.click();
  URL.revokeObjectURL(url);
}
async function importJobs(event) {
  const file = event.target.files[0];
  event.target.value = "";
  if (!file || !currentUser) return;
  try {
    const data = JSON.parse(await file.text());
    if (!Array.isArray(data)) throw new Error("This backup is not a job list.");
    if (!confirm("Import " + data.length + " jobs? Jobs with matching IDs will be replaced.")) return;
    for (const item of data) {
      if (!item || typeof item !== "object" || !item.client || !item.address) continue;
      const job = {...item,id:item.id || crypto.randomUUID()};
      const {error} = await db.from("jobs").upsert({
        id:job.id,user_id:currentUser.id,job_data:job,
        updated_at:new Date().toISOString()
      });
      if (error) throw error;
    }
    await loadJobs();
    showMessage("Backup imported.", "success");
  } catch (err) {
    showMessage("Import failed: " + err.message, "error");
  }
}
db.auth.getSession().then(({data}) => {
  currentUser = data.session?.user || null;
  updateScreen();
});
</script>
</body>
</html>
